# ─────────────────────────────────────────────────
# Telegram Support Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Required ─────────────────────────────────────────

# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Numeric ID of your forum-enabled Telegram group
# (must start with -100...; topics must be enabled)
TELEGRAM_GROUP_ID=-1001234567890

# Comma-separated Telegram user IDs of admins
# who can reply to users and use admin commands
TELEGRAM_ADMINS=123456789,987654321

# Public HTTPS URL where this bot is hosted
# (used to register the webhook with Telegram)
WEBSITE_URL=https://your-app.onrender.com

# Optional ─────────────────────────────────────────

# Port for the Flask web server (default: 8443)
PORT=8443

# Path to the SQLite database file (default: bot_data.db)
DB_PATH=bot_data.db

# Rate limiting: max messages a user can send per window
RATE_LIMIT_MAX=5

# Rate limiting: window duration in seconds
RATE_LIMIT_WINDOW=10
