# ─────────────────────────────────────────────────
# Telegram Support Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Required ─────────────────────────────────────────

# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Numeric ID of your forum-enabled Telegram group
# (must start with -100...; topics must be enabled)
TELEGRAM_GROUP_ID=-1001234567890

# Comma-separated Telegram user IDs of admins
# who can reply to users and use admin commands
TELEGRAM_ADMINS=123456789,987654321

# Public HTTPS URL where this bot is hosted
# (used to register the webhook with Telegram)
# Not required when USE_POLLING=true
WEBSITE_URL=https://your-app.onrender.com

# Set to "true" to use long-polling instead of a webhook.
# Recommended on a VPS — no HTTPS/SSL setup required.
# USE_POLLING=true

# Optional ─────────────────────────────────────────

# Port for the Flask web server (default: 8443)
PORT=8443

# Path to the SQLite database file (default: bot_data.db)
# On the VPS the container mounts a host folder at /data (see Dockerfile / docker run
# -v /opt/telegram-support-bot/data:/data), so point the DB at that volume to persist
# it across redeploys:  DB_PATH=/data/bot_data.db
DB_PATH=bot_data.db

# Rate limiting: max messages a user can send per window
RATE_LIMIT_MAX=5

# Rate limiting: window duration in seconds
RATE_LIMIT_WINDOW=10

# How often (seconds) to reassure a user their message was received. The bot sends a
# single debounced "message received" text instead of reacting to every message
# (reactions made users think an admin was live, and they blocked the bot).
# Set 0 to disable the acknowledgement entirely. Default: 1800 (30 min).
ACK_COOLDOWN=1800

# Expected reply window shown to users (in the welcome + acknowledgement) so they
# don't expect an instant response. Free text. Default: "within a few hours".
RESPONSE_TIME=within a few hours

# Optional support/office-hours line appended to the welcome message. Leave blank to omit.
# Example: Mon–Fri, 9am–6pm IST
OFFICE_HOURS=
